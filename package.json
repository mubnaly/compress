{
  "name": "rasheeq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rasheeq (رَشيق) - 100% local, offline video compressor: Svelte 5 UI over a managed FFmpeg engine.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "icons": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "build:exe": "node scripts/build-exe.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "build:all": "node scripts/generate-icons.mjs && npm run build && npm run build:exe && npm run build:apk",
    "start": "node server/index.js",
    "server": "node server/index.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "resedit": "^3.1.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
